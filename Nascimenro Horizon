<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Horizon</title>

<style>
    body {
        margin: 0;
        padding: 20px;
        background: #121212;
        color: white;
        font-family: Arial, sans-serif;
    }

    textarea {
        width: 100%;
        height: 80vh;
        box-sizing: border-box;
        resize: vertical;

        background: #1e1e1e;
        color: white;

        border: 1px solid #444;
        border-radius: 10px;

        padding: 15px;

        font-size: 16px;
        line-height: 1.5;

        outline: none;
    }

    button {
        width: 100%;
        margin-top: 12px;
        padding: 15px;

        border: none;
        border-radius: 10px;

        background: #d4af37;
        color: #111;

        font-size: 16px;
        font-weight: bold;
    }

    #status {
        text-align: center;
        margin-top: 10px;
        color: #aaa;
    }
</style>
</head>

<body>

<textarea id="texto" placeholder="Cole ou escreva aqui..."></textarea>

<button onclick="salvar()">Salvar no GitHub</button>

<div id="status"></div>

<script>

const OWNER = "danielnep";
const REPO = "Servidor-Para-IAs";
const FILE = "Nascimenro Horizon";
const BRANCH = "main";

async function salvar() {

    const texto = document.getElementById("texto").value;
    const status = document.getElementById("status");

    if (!texto.trim()) {
        status.textContent = "Digite ou cole algum texto.";
        return;
    }

    const token = prompt("Cole seu GitHub Token:");

    if (!token) {
        status.textContent = "Cancelado.";
        return;
    }

    status.textContent = "Salvando...";

    try {

        const url =
            `https://api.github.com/repos/${OWNER}/${REPO}/contents/${encodeURIComponent(FILE)}`;

        // Pega o SHA do arquivo atual
        const consulta = await fetch(
            `${url}?ref=${BRANCH}`,
            {
                headers: {
                    Authorization: `Bearer ${token}`,
                    Accept: "application/vnd.github+json"
                }
            }
        );

        let sha = null;

        if (consulta.ok) {
            const arquivo = await consulta.json();
            sha = arquivo.sha;
        }

        // Converte o texto para Base64 mantendo acentos
        const bytes = new TextEncoder().encode(texto);

        let binary = "";

        for (const byte of bytes) {
            binary += String.fromCharCode(byte);
        }

        const conteudo = btoa(binary);

        // Salva no GitHub
        const resposta = await fetch(url, {

            method: "PUT",

            headers: {
                Authorization: `Bearer ${token}`,
                Accept: "application/vnd.github+json",
                "Content-Type": "application/json"
            },

            body: JSON.stringify({
                message: "Atualiza Nascimenro Horizon",
                content: conteudo,
                sha: sha,
                branch: BRANCH
            })
        });

        if (!resposta.ok) {

            const erro = await resposta.json();

            throw new Error(
                erro.message || "Não foi possível salvar."
            );
        }

        status.textContent = "✓ Salvo no GitHub.";

    } catch (erro) {

        console.error(erro);

        status.textContent =
            "Erro: " + erro.message;
    }
}

</script>

</body>
</html>